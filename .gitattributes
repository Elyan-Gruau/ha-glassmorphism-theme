# Auto detect text files and normalize to LF in the repo, regardless of OS.
* text=auto eol=lf

# Explicit text types, LF always.
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sh   text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, never touched by line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
